TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
BLOB_READ_WRITE_TOKEN=
SITE_ANALYTICS_SALT=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
OAUTH_STATE_SIGNING_SECRET=

# Free, no-card fallback for AI generation/embeddings when AI Gateway has no
# credit card on file — get a free key at https://aistudio.google.com/apikey.
# See src/lib/ai/gateway.ts (resolveModel/resolveEmbeddingModel).
GOOGLE_GENERATIVE_AI_API_KEY=

AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HEADHUNTER_CLIENT_ID=
HEADHUNTER_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=

# Admin panel login — generate ADMIN_PASSWORD_HASH with hashAdminPassword()
# from src/lib/admin/password.ts, never store the raw password.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Payme/Click checkout links (public-ish IDs, shown to payers) and merchant
# webhook auth secrets (never expose). Get these from the Payme Business /
# Click Merchant Cabinet after signing a merchant agreement.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Enables OpenAI TTS (voice replies) and Whisper STT (voice transcription).
# Without it, both fall back to a silent/placeholder response — see
# src/lib/voice/tts-stt.ts and src/lib/ai/multimodal.ts.
OPENAI_API_KEY=

# Outbound SIP/telephony provider (e.g. Zadarma, Voximplant, a Twilio SIP
# trunk). Required for real outbound AI voice calls — see src/lib/voice/*.
SIP_PROVIDER_URL=
SIP_PROVIDER_API_KEY=
